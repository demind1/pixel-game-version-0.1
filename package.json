{
  "name": "hivebreak-reforged",
  "version": "1.2.0",
  "private": true,
  "description": "Ксеноморф: Прорыв улья — 3D Reforged 1.2",
  "scripts": {
    "start": "python3 -m http.server 8080 --bind 0.0.0.0",
    "test": "node test_engine.js && node tests/audio.test.js && node tests/campaign.test.js && node tests/character_motion.mjs && node tests/progression.test.js",
    "test:browser": "python3 tests/browser_regression.py",
    "build": "npm run build:renderer && python3 build_portable.py",
    "build:renderer": "esbuild src/renderer3d.js --bundle --minify --format=iife --outfile=vendor/renderer3d.js --legal-comments=inline",
    "test:3d": "python3 tests/browser_10.py",
    "test:motion": "node tests/character_motion.mjs"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "esbuild": "0.25.0"
  }
}
